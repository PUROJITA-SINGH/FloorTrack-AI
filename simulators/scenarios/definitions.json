    "camera": {
      "enabled": true,
      "camera_name": "CAM-1",
      "asset_code": "P-002",
      "zone_name": "Ward A",
      "confidence": 0.95
    },
    "ble": {
      "enabled": true,
      "asset_code": "P-002",
      "events": [
        {
          "timestamp": "now",
          "readings": [
            {"gateway_name": "GW-1", "rssi": -45},
            {"gateway_name": "GW-2", "rssi": -75}
          ]
        }
      ]
    },
    "expected": {
      "decision_status": "confirmed",
      "zone_name": "Ward A",
      "camera_and_ble_agree": true
    }
  },
