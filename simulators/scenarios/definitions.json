  "ble_signal_bleeding": {
    "description": "Camera reports Ward A while BLE signal bleeding estimates Ward B; this must require review.",
    "camera": {
      "enabled": true,
      "camera_name": "CAM-1",
      "asset_code": "P-004",
      "zone_name": "Ward A",
      "confidence": 0.95
    },
    "ble": {
      "enabled": true,
      "asset_code": "P-004",
      "events": [
        {
          "timestamp": "now",
          "readings": [
