{
  "normal_movement": {
    "description": "P-001 moves from Ward A to Ward B with agreeing camera and BLE observations.",
    "camera": {
      "enabled": true,
      "camera_name": "CAM-2",
      "asset_code": "P-001",
      "zone_name": "Ward A",
      "events": [
        {"zone_name": "Ward A", "timestamp": "now", "confidence": 0.9},
        {"zone_name": "Ward B", "timestamp": "now", "confidence": 0.92}
      ]
    },
    "ble": {
      "enabled": true,
      "asset_code": "P-001",
      "events": [
        {
          "timestamp": "now",
          "readings": [
            {"gateway_name": "GW-1", "rssi": -45},
            {"gateway_name": "GW-2", "rssi": -75}
          ]
        },
        {
          "timestamp": "now",
          "readings": [
            {"gateway_name": "GW-1", "rssi": -50},
            {"gateway_name": "GW-2", "rssi": -50}
          ]
        }
      ]
    },
    "expected": {
      "decision_status": "confirmed",
      "zone_name": "Ward B",
      "camera_and_ble_agree": true
    }
  },
  "agreement": {
